{
  "uid": "masular-throughput",
  "title": "Mas Sular — Pipeline Throughput",
  "tags": ["masular", "pipeline"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Outbox publish rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_relay_published_total[5m])", "legendFormat": "published/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_relay_retry_total[5m])", "legendFormat": "retries/s" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer enqueue rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_consumer_enqueued_total[5m])", "legendFormat": "enqueued/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_consumer_duplicate_total[5m])", "legendFormat": "duplicates/s" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sender send rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_sender_sent_total[5m])", "legendFormat": "sent/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_sender_claimed_total[5m])", "legendFormat": "claimed/s" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Sender result rate by class",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (result) (rate(masular_notification_sender_result_total[5m]))", "legendFormat": "{{result}}" }
      ]
    }
  ]
}
