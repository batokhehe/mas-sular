{
  "uid": "masular-errors",
  "title": "Mas Sular — Pipeline Errors",
  "tags": ["masular", "pipeline"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Relay failures",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_relay_failed_total[5m])", "legendFormat": "failed/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "increase(masular_relay_failed_total[15m])", "legendFormat": "failed (15m)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sender terminal failures",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_sender_failed_permanent_total[5m])", "legendFormat": "permanent/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_sender_failed_exhausted_total[5m])", "legendFormat": "exhausted/s" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumer retries & dead-letters",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_consumer_retried_total[5m])", "legendFormat": "retried/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(masular_notification_consumer_dead_lettered_total[5m])", "legendFormat": "dead-lettered/s" }
      ]
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Breaker / pause state (1 = open/paused)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_notification_sender_breaker_open", "legendFormat": "sender breaker" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_notification_consumer_paused", "legendFormat": "consumer paused" }
      ]
    }
  ]
}
