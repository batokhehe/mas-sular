{
  "uid": "masular-saturation",
  "title": "Mas Sular — Pipeline Saturation",
  "tags": ["masular", "pipeline"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Relay backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_relay_backlog", "legendFormat": "PENDING" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_relay_failed_backlog", "legendFormat": "FAILED" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Notification backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_notification_backlog", "legendFormat": "PENDING" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_notification_failed_backlog", "legendFormat": "FAILED" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Oldest pending age",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_relay_oldest_pending_age_seconds", "legendFormat": "relay" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "masular_notification_sender_oldest_pending_age_seconds", "legendFormat": "notification" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer DLQ depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(rabbitmq_queue_messages{queue=\"order.created.notifications.dlq\"})", "legendFormat": "dlq depth" }
      ]
    }
  ]
}
