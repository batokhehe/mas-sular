node_modules
.next
dist
# Coverage output is scoped per package: a bare `coverage` pattern is unanchored
# and also matched admin/components/coverage/, silently untracking real source
# and breaking the admin build from a clean checkout (F67).
backend/coverage/
frontend/coverage/
admin/coverage/
e2e/coverage/
.env
.env.*
!.env.example
# Runtime customer uploads (receipt images). Scoped: a bare `uploads` pattern
# also matched backend/src/uploads/, a source path.
backend/uploads/
tmp
*.log

# Production compose secrets (template lives in production.env.example)
production.env

# Backup artifacts — NEVER commit. Scoped deliberately narrow: the backend repo
# tracks 35 legitimate prisma/migrations/*.sql files, so a blanket *.sql rule
# would silently untrack real migrations.
backups/
scripts/backup/*.log
*.sql.gz
*.tar.gz
*.enc
*.bak

# RajaOngkir acquisition artifacts (PAXELBOX-51) — raw API responses and the
# resume checkpoint. Generated by a one-off operator run, potentially large, and
# not source. Scoped deliberately narrow: prisma/data/ also holds the COMMITTED
# Kemendagri seed (regions.full.json, regions.types.ts), so a blanket rule there
# would silently untrack real seed data.
backend/prisma/data/rajaongkir-cache/

# Captured JNE API responses (PAXELBOX-61C/61L/61M), preserved locally in 61Y so
# that regenerating them never costs JNE API quota. They carry no credentials —
# JNE authenticates in the REQUEST, never the response — but they are captures,
# not source, and belong to no repository. Scoped to the directory alone: a
# broader rule such as *.out.json would reach into backend/ and frontend/ where
# nothing of the sort is generated today, and would silently hide it if it were.
.artifacts/
