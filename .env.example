# Mas Sular - root .env: docker-compose.yml INTERPOLATION values only.
#   cp .env.example .env        # optional - every value below has the same default in docker-compose.yml
#
# Read by `docker compose` (LOCAL stack), never by an application. App config lives in:
#   backend/.env.example   (backend; Docker loads it directly, optional override backend/.env.docker)
#   frontend/.env.example  (storefront `next dev`)
#   admin/.env.example     (admin `next dev`)
# PRODUCTION uses ../production.env (template production.env.example) with
# docker-compose.production.yml - not this file.

# --- Local PostgreSQL + RabbitMQ credentials ------------------------------------
# Localhost-only development defaults. If you change them, change DATABASE_URL /
# RABBITMQ_URL in backend/.env (host development) to match.
POSTGRES_DB=massular
POSTGRES_USER=massular
POSTGRES_PASSWORD=massular_dev
RABBITMQ_USER=massular
RABBITMQ_PASSWORD=massular_dev

# --- Host ports (optional) ---------------------------------------------------------
# Override when a port is already taken on your machine. Containers talk to each
# other over service DNS and never use these. A changed infra port must also be
# changed in backend/.env; a changed BACKEND_HOST_PORT in the NEXT_PUBLIC_* URLs.
#POSTGRES_HOST_PORT=5432
#REDIS_HOST_PORT=6379
#RABBITMQ_HOST_PORT=5672
#RABBITMQ_MGMT_HOST_PORT=15672
#BACKEND_HOST_PORT=3001
#FRONTEND_HOST_PORT=3000
#ADMIN_HOST_PORT=3002

# --- Storefront / admin image build args (optional) -----------------------------------
# Compiled into the browser bundles at BUILD time: public, never secrets. After a
# change run `docker compose up -d --build frontend admin`.
# Storefront: the BARE API origin (it appends /api/v1 itself).
#NEXT_PUBLIC_API_URL=http://localhost:3001
# Admin: the API base INCLUDING /api/v1 (it appends paths directly).
#NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api/v1
# Storefront Google Sign-In: the same client id as the backend's GOOGLE_CLIENT_ID.
#NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Storefront support link (unset = mailto:cs@baksomassular.com).
#NEXT_PUBLIC_SUPPORT_URL=
