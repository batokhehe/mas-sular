# Mas Sular storefront - LOCAL DEVELOPMENT template (`next dev`, http://localhost:3000).
#   cp frontend/.env.example frontend/.env
#
# Every value here is NEXT_PUBLIC_*: compiled into the BROWSER bundle and public by
# definition. Never put a secret here.
#
# PRODUCTION DOES NOT READ THIS FILE. The production image takes these as Docker
# BUILD ARGS from ../production.env (template ../production.env.example); changing
# one requires rebuilding the image.

# The BARE backend origin - the storefront appends /api/v1 itself. Never end it
# with /api/v1 (that yields /api/v1/api/v1/...; the image build refuses it).
# This is the opposite of the admin, whose NEXT_PUBLIC_API_URL includes /api/v1.
# Empty = same origin (/api/v1 served behind a reverse proxy).
# [PROD] https://<API_DOMAIN>
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Sign-In client id - the SAME value as the backend's GOOGLE_CLIENT_ID. Its
# authorized JavaScript origins must include this storefront's origin.
# Empty = the Google button reports "not configured".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional support link on the payment-success page.
# Unset = mailto:cs@baksomassular.com
# NEXT_PUBLIC_SUPPORT_URL=mailto:support@your-domain.example

# Floating WhatsApp support button. Normalized to 62... (08..., +62, spaces, dashes
# accepted). Empty or invalid = the button is hidden. The message is optional.
NEXT_PUBLIC_WHATSAPP_NUMBER=628811010452031
NEXT_PUBLIC_WHATSAPP_MESSAGE=Halo Kak, saya ingin bertanya mengenai Bakso Mas Sular.
