# =============================================================================
# Mas Sular backend - LOCAL DEVELOPMENT environment template
# Validated at startup by src/common/config/env.validation.ts (fail-fast).
#
# Host development (API via `pnpm dev`, infra via `docker compose up -d postgres redis rabbitmq`):
#   cp backend/.env.example backend/.env
# Local Docker (`docker compose up -d`): nothing to copy. docker-compose.yml loads
# THIS file as the backend's base config and overrides DATABASE_URL / REDIS_URL /
# RABBITMQ_URL / NODE_ENV / PORT with service-DNS values. For your own values
# (e.g. sandbox credentials) create the OPTIONAL, gitignored override
# backend/.env.docker containing only the keys you change.
#
# PRODUCTION DOES NOT READ THIS FILE. docker-compose.production.yml loads
# ../production.env, created from ../production.env.example. Lines tagged [PROD]
# name the value production uses there instead.
#
# Rules:
#   - CHANGE_ME values boot locally but are REFUSED in staging/production.
#   - Keys validated for SHAPE (URLs, enums, numbers, phone formats) must be
#     ABSENT (commented out) when unused - an EMPTY value fails startup.
#   - Never put a real credential in this file; it is committed.
#   - Never follow an EMPTY value with an inline comment (`KEY=   # note`):
#     Docker Compose would read the comment as the value. Comment on the line above.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development                 # development | test | staging | production. [PROD] production
PORT=3001
SWAGGER_ENABLED=false                # /docs is always on outside production; true re-enables it in production

# --- Core infrastructure (REQUIRED) -------------------------------------------
# The PostgreSQL / Redis / RabbitMQ from docker-compose.yml, reached from the host.
# If you changed POSTGRES_HOST_PORT / REDIS_HOST_PORT / RABBITMQ_HOST_PORT in the
# root .env, change the ports here to match.
# Size the Prisma pool explicitly in production (connection_limit per instance,
# instances * connection_limit < PostgreSQL max_connections).
# [PROD] postgresql://<user>:<pass>@postgres:5432/<db>?connection_limit=15&pool_timeout=20&schema=public
DATABASE_URL=postgresql://massular:massular_dev@localhost:5432/massular?schema=public
# [PROD] redis://redis:6379
REDIS_URL=redis://localhost:6379
# Required when OUTBOX_RELAY_ENABLED or CONSUMERS_ENABLED is true. Credentials are
# the local broker's (root .env RABBITMQ_USER / RABBITMQ_PASSWORD).
# [PROD] amqp://<user>:<pass>@rabbitmq:5672
RABBITMQ_URL=amqp://massular:massular_dev@localhost:5672

# --- Auth secrets (REQUIRED; each >= 32 chars and all different) -------------
# [PROD] each a DIFFERENT `openssl rand -hex 32`.
JWT_ACCESS_SECRET=CHANGE_ME_local_dev_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_local_dev_refresh_secret_min_32_chars
JWT_ADMIN_ACCESS_SECRET=CHANGE_ME_local_dev_admin_secret_min_32_chars
# cookie-parser secret. No cookie is signed with it today; keep it unique anyway.
COOKIE_SECRET=CHANGE_ME_local_dev_cookie_secret_min_32_chars
JWT_ACCESS_TTL=15m                   # customer access token
JWT_REFRESH_TTL=30d
JWT_ADMIN_ACCESS_TTL=1d

# Google Sign-In OAuth client id (REQUIRED, verified server-side). The storefront's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID must be the SAME id. Login needs a real id; the
# placeholder only lets the API boot. [PROD] <GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# --- Public URLs ----------------------------------------------------------------
# API origin; also the origin of uploaded-file URLs (/uploads/...). [PROD] https://<API_DOMAIN>
APP_URL=http://localhost:3001
# STOREFRONT origin. Customer links are built on it: invoice /invoice/<token> and
# receipt upload /payment/<token>. Without it invoice links fail (503).
# [PROD] https://<SHOP_DOMAIN>
PAYMENT_UPLOAD_BASE_URL=http://localhost:3000
# ADMIN origin, used in links inside operational notifications. [PROD] https://<ADMIN_DOMAIN>
ADMIN_URL=http://localhost:3002

# --- CORS, reverse proxy, cookies, CSRF --------------------------------------------
# Browser origins allowed to call the API with credentials: storefront + admin.
# Explicit list, never "*". [PROD] https://<SHOP_DOMAIN>,https://<ADMIN_DOMAIN>
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Reverse-proxy hops trusted for req.ip / rate limiting. 0 = no proxy (local).
# [PROD] 1 (required: one Caddy/Nginx in front of the API)
TRUST_PROXY_HOPS=0
# The storefront authenticates with the httpOnly cookie and sends NO Authorization
# header, so this must be true or every customer request is anonymous. [PROD] true
AUTH_COOKIE_EXTRACTOR_ENABLED=true
# Local HTTP cannot carry Secure cookies. Unset = true only when NODE_ENV=production.
# [PROD] true
COOKIE_SECURE=false
# Host-only cookies locally. If the API is on a different host than the storefront,
# set the shared parent domain or the storefront cannot read XSRF-TOKEN and every
# write returns 403. [PROD] .<ROOT_DOMAIN>
# COOKIE_DOMAIN=.your-domain.example
# COOKIE_SAMESITE=lax                # lax | strict | none (none requires COOKIE_SECURE=true)
# Double-submit CSRF for cookie-authenticated writes. Default enforce; "report" only
# logs "[CSRF report] would block" and is a temporary rollout diagnostic.
# CSRF_MODE=enforce

# --- Checkout -------------------------------------------------------------------
# Idempotent /checkout/order. Optional locally. [PROD] both true (boot refuses otherwise)
CHECKOUT_IDEMPOTENCY_ENABLED=false
CHECKOUT_IDEMPOTENCY_REQUIRED=false  # true requires CHECKOUT_IDEMPOTENCY_ENABLED=true
# Manual BANK_TRANSFER unique code added to the transfer amount (never on gateway
# payments). A business decision; off by default. Range: min >= 0, max <= 999, max > min.
PAYMENT_UNIQUE_CODE_ENABLED=false
PAYMENT_UNIQUE_CODE_MIN=100
PAYMENT_UNIQUE_CODE_MAX=999

# --- Payment lifecycle (reminders + expiry; OFF by default) ------------------------
PAYMENT_LIFECYCLE_ENABLED=false      # [PROD] true
# Windows must satisfy FIRST < SECOND < EXPIRY. Unset = the code defaults shown:
# PAYMENT_FIRST_REMINDER_MS=43200000   # 12 h
# PAYMENT_SECOND_REMINDER_MS=72000000  # 20 h
# PAYMENT_EXPIRY_MS=86400000           # 24 h (manual transfer)
# Gateway attempts expire after 24 h (0 = never). Set explicitly: the payment
# lifecycle and the stock-reservation hold do not share one code default.
PAYMENT_GATEWAY_EXPIRY_MS=86400000

# --- Payment gateway (Midtrans; OFF by default) --------------------------------------
# With MIDTRANS_ENABLED=false the provider is not registered and checkout offers
# manual bank transfer only. Use SANDBOX keys locally; never production keys.
MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false         # false = sandbox Core API. Boot refuses a sandbox/production mismatch
# MIDTRANS_SERVER_KEY: REQUIRED when MIDTRANS_ENABLED=true (server-side secret)
MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY: reserved for card tokenisation; not read by any code path yet
MIDTRANS_CLIENT_KEY=
MIDTRANS_TIMEOUT_MS=10000            # per-attempt HTTP timeout
MIDTRANS_MAX_RETRY=2                 # retries on 429/500/502/503/504 only
# Core API endpoint override. Leave ABSENT: it is derived from MIDTRANS_IS_PRODUCTION
# (sandbox vs production), and an EMPTY value fails startup. Uncomment only to reach
# Midtrans through a custom/proxy endpoint. Unrelated to the webhook URL (APP_URL).
# MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com

# --- Payment service fee ("Biaya Layanan") - INDEPENDENT of MIDTRANS_ENABLED ------------
# Every MIDTRANS_ENABLED x PAYMENT_SERVICE_FEE_ENABLED combination is valid. This only
# decides WHO bears the applicable Midtrans fee on gateway payments (manual bank
# transfer never carries one).
#   true  - the applicable fee MAY be charged to the customer, per channel rule:
#           virtual accounts (BCA/BNI/BRI/Permata/Mandiri bill) Rp4,000 and
#           GoPay/ShopeePay 2% are passed on. QRIS (0.7%, Bank Indonesia MDR) and
#           cards (2.9% + Rp2,000) are NEVER passed on - the merchant absorbs them
#           even when this is true.
#   false - the customer service fee is Rp0 ("Biaya Layanan Rp0"); the applicable
#           merchant-side fee is still calculated and recorded per order and per
#           payment attempt.
# Get legal sign-off before true (PBI 23/6/PBI/2021 Pasal 52). [PROD] false until then.
PAYMENT_SERVICE_FEE_ENABLED=false

# --- Async pipeline (OFF by default) ------------------------------------------------
# Transactional outbox -> RabbitMQ -> consumers. Both need RABBITMQ_URL. [PROD] true
OUTBOX_RELAY_ENABLED=false
CONSUMERS_ENABLED=false

# --- Customer notifications: sender + delivery gate ---------------------------------
# Nothing is sent unless the sender is on AND the delivery gate is open AND the
# recipient is allowed. Keep all of it off locally.
NOTIFICATION_SENDER_ENABLED=false
NOTIFICATION_PROVIDER=multi          # multi (route by channel) | email (force email) | qontak (force WhatsApp)
NOTIFICATION_DELIVERY_ENABLED=false  # "true" (exact) to permit outbound sends
# allowlist: only NOTIFICATION_ALLOWED_RECIPIENTS may receive (empty = nobody).
# all: every recipient - production only (boot rejects it elsewhere).
NOTIFICATION_RECIPIENT_POLICY=allowlist
# NOTIFICATION_ALLOWED_RECIPIENTS: comma-separated MSISDNs/emails cleared for delivery
NOTIFICATION_ALLOWED_RECIPIENTS=

# Email via Resend - RESEND_API_KEY and EMAIL_FROM are REQUIRED when the sender is on.
RESEND_API_KEY=
EMAIL_FROM=orders@your-domain.example              # must be on a domain verified in Resend
ADMIN_NOTIFICATION_EMAIL=ops@your-domain.example   # recipient for "new receipt to verify"

# WhatsApp via Mekari Qontak. API token, channel id, ORDER and COD template ids are
# REQUIRED when the sender is on and NOTIFICATION_PROVIDER is not "email".
QONTAK_API_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
# One template id per business event - never reuse one for two:
# QONTAK_INVOICE_TEMPLATE_ID: CUSTOMER invoice: 6 params (name, order, total, bank, holder, acct) + upload-token button
QONTAK_INVOICE_TEMPLATE_ID=
# QONTAK_ORDER_TEMPLATE_ID: ADMIN "Pesanan Baru": 6 params (order, customer, total, method, status, shipping) + Order.id button
QONTAK_ORDER_TEMPLATE_ID=
# QONTAK_COD_TEMPLATE_ID: COD template
QONTAK_COD_TEMPLATE_ID=
# QONTAK_SHIPPED_TEMPLATE_ID: CUSTOMER shipped: 4 params (name, order, courier, AWB)
QONTAK_SHIPPED_TEMPLATE_ID=
# QONTAK_DELIVERED_TEMPLATE_ID: CUSTOMER delivered: 2 params (name, order)
QONTAK_DELIVERED_TEMPLATE_ID=
# QONTAK_SHIPMENT_TEMPLATE_ID: optional generic shipment status update
QONTAK_SHIPMENT_TEMPLATE_ID=
# QONTAK_MANUAL_TEMPLATE_ID: free-text template ({{1}}=message); admin manual sends and "Send invoice via WhatsApp"
QONTAK_MANUAL_TEMPLATE_ID=
# QONTAK_ADMIN: operational WhatsApp recipient for admin alerts (MSISDN, e.g. 628xxxxxxxxxx)
QONTAK_ADMIN=
QONTAK_TIMEOUT_MS=10000
QONTAK_MAX_RETRY=1                   # in-call retries; the durable outbox retry is authoritative
# Endpoint override. Leave ABSENT (defaults to the real Qontak endpoint); empty fails startup.
# QONTAK_BASE_URL=https://service-chat.qontak.com

# --- Admin notification platform (bell / SSE / web push) ------------------------------
# Firebase service-account JSON on one line enables FCM web push. Absent = push off.
# It contains a private key: never commit a real one.
# FIREBASE_SERVICE_ACCOUNT_JSON=
NOTIFICATION_RETENTION_ENABLED=true
NOTIFICATION_RETENTION_DAYS=90       # delete admin notifications older than this
NOTIFICATION_RETENTION_BATCH_SIZE=1000
PUSH_TOKEN_STALE_DAYS=60             # remove push tokens not seen for this long
SSE_MAX_CONNECTION_AGE_MINUTES=60    # recycle SSE connections (clients reconnect)

# --- Logging, retention, observability -----------------------------------------------
SYSTEM_LOG_ENABLED=true              # persist structured logs (SystemLog)
SYSTEM_LOG_RETENTION_ENABLED=true    # daily SystemLog retention sweep
LOG_RETENTION_DAYS=90
# Deletes old outbox / processed-event / upload-token rows. [PROD] true, dry run first.
RETENTION_ENABLED=false
RETENTION_DRY_RUN=false
APP_VERSION=0.1.0                    # surfaced as masular_build_info

# --- Shipping providers (all OFF by default) ---------------------------------------
# The shipping ORIGIN is the ACTIVE outlet's postal code (admin panel -> Outlets).
# SHIPPING_ORIGIN_POSTAL_CODE is obsolete: the validator still accepts it, but no
# code reads it. Do not set it.
# When a provider is enabled its credentials are validated at boot. Local and
# staging use mock rates for couriers without credentials.

# Paxel
PAXEL_ENABLED=false
PAXEL_BASE_URL=https://api.paxel.co  # code default; [PROD] set explicitly from Paxel
# PAXEL_API_KEY: required when PAXEL_ENABLED=true
PAXEL_API_KEY=
# PAXEL_API_SECRET: required when PAXEL_ENABLED=true; signs X-Paxel-Signature
PAXEL_API_SECRET=
PAXEL_DEFAULT_DIMENSION=30x35x20     # parcel LxWxH cm (1..50 each); Paxel prices from it
PAXEL_NEED_INSURANCE=false           # costs money per shipment; only "true" turns it on
PAXEL_TIMEOUT_MS=8000
PAXEL_MAX_RETRY=2                    # quotes only; Paxel CREATE is never retried
# Required when PAXEL_ENABLED=true - uncomment and fill both (empty fails startup):
# PAXEL_ORIGIN_PHONE=<9_TO_13_DIGITS>          # merchant pickup contact, digits only, no + or spaces
# PAXEL_ORIGIN_NOTE=<REAL_PICKUP_INSTRUCTION>  # pickup instruction shown to the courier
# Courier pickup rule (one rule for every courier, DEFAULT_PICKUP_POLICY in
# shipping.config.ts): verified at or before the CUT-OFF (15:00) -> pickup the same
# day at 17:00 Asia/Jakarta; after the cut-off -> the next day at 17:00. No weekend,
# holiday or operating-hours logic. Paxel is sent the slot; JNE only records it.
PAXEL_AUTO_PICKUP_ENABLED=false      # Paxel's automatic booking switch; only "true" turns it on
# Optional overrides of the rule above (a value that is set must be valid):
# PAXEL_PICKUP_TIMEZONE=Asia/Jakarta
# PAXEL_PICKUP_CUTOFF_TIME=15:00       # HH:mm - last eligible payment VERIFICATION time
# PAXEL_PICKUP_DEFAULT_TIME=17:00      # HH:mm - the courier appointment itself

# JNE
JNE_ENABLED=false
JNE_ENVIRONMENT=sandbox              # sandbox | production (production requires JNE_BASE_URL)
JNE_BASE_URL=https://apiv2.jne.co.id:10102   # [PROD] <JNE_PRODUCTION_BASE_URL_FROM_JNE>; the sandbox endpoint is refused there
# JNE_API_KEY: required when JNE_ENABLED=true
JNE_API_KEY=
# JNE_USERNAME: required when JNE_ENABLED=true
JNE_USERNAME=
# JNE_ORIGIN_CODE: required when JNE_ENABLED=true (JNE origin city code)
JNE_ORIGIN_CODE=
JNE_TIMEOUT_MS=8000
JNE_MAX_RETRY=2
# JNE Webhook Status V2 - inbound status pushes from JNE. Endpoint (register with JNE):
#   <APP_URL>/api/v1/shipments/webhook/jne   (locally http://localhost:3001/api/v1/shipments/webhook/jne)
# JNE's V2 documentation defines NO webhook authentication (the body's `signature`
# is the recipient's signature IMAGE URL). Off until deliberately enabled; in
# production also restrict the path to JNE's source IPs at the reverse proxy.
JNE_WEBHOOK_ENABLED=false

# RajaOngkir (Komerce) - legacy quote source, not used in production. It is only
# active when RAJAONGKIR_ENABLED=true AND RAJAONGKIR_API_KEY is set.
RAJAONGKIR_ENABLED=false
# RAJAONGKIR_API_KEY=
# RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1   # code default
# RAJAONGKIR_TIMEOUT_MS=8000
# RAJAONGKIR_MAX_RETRY=1

# --- Address geocoding (Google Geocoding API, server-side; OFF by default) -------------
# Enabling it makes address creation depend on Google (a failed lookup is an error,
# never a fake coordinate). The key is SERVER-SIDE ONLY - never NEXT_PUBLIC_*.
GEOCODING_ENABLED=false
# GOOGLE_MAPS_API_KEY: required when GEOCODING_ENABLED=true
GOOGLE_MAPS_API_KEY=
GEOCODING_TIMEOUT_MS=5000
# Endpoint override for tests/proxies. Leave ABSENT (defaults to Google's endpoint).
# GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json

# --- Background workers (all OFF by default) ---------------------------------------
# Courier tracking polls (IN_TRANSIT -> DELIVERED). [PROD] true
SHIPMENT_TRACKING_ENABLED=false
SHIPMENT_TRACKING_POLL_INTERVAL_MS=300000
SHIPMENT_TRACKING_BATCH_SIZE=50
# Books paid orders whose automatic courier booking never ran. [PROD] true
SHIPMENT_RECONCILIATION_ENABLED=false
SHIPMENT_RECONCILIATION_INTERVAL_MS=60000
SHIPMENT_RECONCILIATION_BATCH_SIZE=50
SHIPMENT_RECONCILIATION_DELAY_MS=120000
# Releases expired stock reservations. [PROD] true
INVENTORY_RESERVATION_WORKER_ENABLED=false
INVENTORY_RESERVATION_POLL_MS=60000
INVENTORY_RESERVATION_INITIAL_DELAY_MS=30000
INVENTORY_RESERVATION_BATCH_SIZE=100
INVENTORY_RESERVATION_HEALTH_LOG_MS=300000
# Recovers gateway charges whose webhook never arrived, through the same transition
# the webhook uses. Only meaningful with Midtrans. [PROD] true once Midtrans is live
MIDTRANS_RECONCILIATION_ENABLED=false
MIDTRANS_RECONCILIATION_INTERVAL_MS=60000
MIDTRANS_RECONCILIATION_INITIAL_DELAY_MS=30000
MIDTRANS_RECONCILIATION_BATCH_SIZE=50
MIDTRANS_RECONCILIATION_MIN_AGE_MS=120000     # grace period only - not a business expiry
MIDTRANS_RECONCILIATION_HEALTH_LOG_MS=300000

# --- Tuning (optional) - leave unset to use the code defaults shown ------------------------
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=50
# OUTBOX_LEASE_MS=30000
# OUTBOX_BACKOFF_BASE_MS=5000
# OUTBOX_BACKOFF_CAP_MS=3600000
# OUTBOX_HEALTH_LOG_INTERVAL_MS=60000
# CONSUMER_PREFETCH=10
# CONSUMER_MAX_ATTEMPTS=5
# CONSUMER_RETRY_DELAY_MS=30000
# NOTIFICATION_SENDER_BATCH_SIZE=50
# NOTIFICATION_SENDER_POLL_INTERVAL_MS=1000
# NOTIFICATION_SENDER_LEASE_MS=30000
# NOTIFICATION_SENDER_BACKOFF_BASE_MS=5000
# NOTIFICATION_SENDER_BACKOFF_CAP_MS=3600000
# NOTIFICATION_SENDER_MAX_ATTEMPTS=8
# NOTIFICATION_SENDER_BREAKER_THRESHOLD=5
# NOTIFICATION_SENDER_PAUSE_MS=30000
# NOTIFICATION_SENDER_HEALTH_LOG_INTERVAL_MS=60000
# EMAIL_REQUEST_TIMEOUT_MS=10000
# IDEMPOTENCY_REPLAY_MODE=snapshot     # snapshot | rehydrate
# IDEMPOTENCY_RETENTION_MS=172800000
# IDEMPOTENCY_RECLAIM_MS=120000
# IDEMPOTENCY_RETRY_AFTER_SECONDS=2
# PAYMENT_LIFECYCLE_POLL_MS=300000
# PAYMENT_LIFECYCLE_INITIAL_DELAY_MS=60000
# PAYMENT_LIFECYCLE_BATCH_SIZE=100
# PAYMENT_UNIQUE_CODE_MAX_ATTEMPTS=10
# RETENTION_BATCH_SIZE=1000
# RETENTION_INTERVAL_MS=86400000
# RETENTION_INITIAL_DELAY_MS=60000
# RETENTION_MAX_BATCHES=1000
# RETENTION_OUTBOX_PUBLISHED_DAYS=7
# RETENTION_OUTBOX_FAILED_DAYS=90
# RETENTION_PROCESSED_DAYS=30
# RETENTION_NOTIFICATION_SENT_DAYS=30
# RETENTION_NOTIFICATION_FAILED_DAYS=90
# RETENTION_UPLOAD_TOKEN_DAYS=14
# LOG_RETENTION_INTERVAL_MS=86400000
# LOG_RETENTION_INITIAL_DELAY_MS=60000
# NOTIFICATION_RETENTION_INTERVAL_MS=86400000
# SHIPMENT_TRACKING_CACHE_TTL_MS=7200000
# SHIPMENT_RECONCILIATION_INITIAL_DELAY_MS=30000
# SHIPMENT_RECONCILIATION_HEALTH_LOG_MS=300000
# INCIDENT_ERROR_RATE_PCT=5
# INCIDENT_QUEUE_PENDING=100
# INCIDENT_WORKER_FAILURES=3
# INCIDENT_NOTIFICATION_FAILURES=5
# INCIDENT_CHECKOUT_P95_MS=3000
# INCIDENT_DB_LATENCY_MS=200
