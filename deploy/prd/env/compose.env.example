# Mas Sular PRODUCTION — compose interpolation values (infrastructure credentials
# and build-time public values). NOT read by the application directly.
#
#   sudo install -d -o massular -g massular -m 700 /etc/mas-sular-prd
#   cp deploy/prd/env/compose.env.example /etc/mas-sular-prd/compose.env
#   chmod 600 /etc/mas-sular-prd/compose.env
#
# Every password below is embedded in a connection URL, so it MUST be URL-safe:
# generate each one with `openssl rand -hex 32` (deploy.sh refuses anything else).
# All values must be NEW — never reuse a staging credential.

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=mas_sular
# Cluster superuser: operators and backups only. The app never sees it.
POSTGRES_USER=mas_sular_admin
POSTGRES_PASSWORD=CHANGE_ME
# Created by postgres/initdb/10-roles.sh on FIRST boot (empty volume) only.
APP_DB_OWNER_PASSWORD=CHANGE_ME
APP_DB_APP_PASSWORD=CHANGE_ME

# --- Redis -----------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- RabbitMQ --------------------------------------------------------------------
RABBITMQ_USER=mas_sular
RABBITMQ_PASSWORD=CHANGE_ME

# --- Build-time public values (compiled into the browser bundles) ----------------
# Public by definition — never a secret. A change needs `deploy.sh` (rebuild).
# Storefront: the BARE API origin (the client appends /api/v1 itself).
NEXT_PUBLIC_API_URL=https://api.baksomassular.com
# Admin: the API base INCLUDING /api/v1.
NEXT_PUBLIC_ADMIN_API_URL=https://api.baksomassular.com/api/v1
# Production Google OAuth client (same value as GOOGLE_CLIENT_ID in app.env).
# Its authorized JavaScript origin must be https://ecommerce.baksomassular.com.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME
# Empty = mailto:cs@baksomassular.com
NEXT_PUBLIC_SUPPORT_URL=
# Floating WhatsApp button; empty hides it.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=
