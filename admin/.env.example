# Mas Sular admin - LOCAL DEVELOPMENT template (`next dev`, http://localhost:3002).
#   cp admin/.env.example admin/.env
#
# NEXT_PUBLIC_* is compiled into the BROWSER bundle and public by definition.
# Never put a secret here. This is the only variable the admin reads.
#
# PRODUCTION DOES NOT READ THIS FILE. The production image takes it as a Docker
# BUILD ARG from NEXT_PUBLIC_ADMIN_API_URL in ../production.env (template
# ../production.env.example); changing it requires rebuilding the image.

# The API base INCLUDING /api/v1 - the admin appends request paths directly.
# This DIFFERS from the storefront, whose NEXT_PUBLIC_API_URL is the bare origin
# (http://localhost:3001). The image build refuses anything that is not
# http(s)://.../api/v1.
# [PROD] https://<API_DOMAIN>/api/v1   (set as NEXT_PUBLIC_ADMIN_API_URL in production.env)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
