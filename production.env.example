# Mas Sular — production compose environment TEMPLATE.
#
#   cp production.env.example production.env      # then fill in real values
#   docker compose --env-file ./production.env -f docker-compose.production.yml up -d
#
# production.env holds live secrets and is gitignored. NEVER commit it.
# Every value below is a placeholder; none is a working credential.

# --- MySQL container (internal network only) --------------------------------
MYSQL_DATABASE=mas_sular
MYSQL_USER=mas_sular
MYSQL_PASSWORD=CHANGE_ME_strong_random
MYSQL_ROOT_PASSWORD=CHANGE_ME_different_strong_random

# Host is the compose service name, resolved over the internal network.
# Size the pool explicitly — the default is shared by HTTP traffic AND every
# background worker, and exhausts silently as P2024 timeouts under load.
DATABASE_URL=mysql://mas_sular:CHANGE_ME_strong_random@mysql:3306/mas_sular?connection_limit=15&pool_timeout=20

# --- Redis / RabbitMQ (internal network only) -------------------------------
REDIS_URL=redis://redis:6379
RABBITMQ_USER=mas_sular
RABBITMQ_PASSWORD=CHANGE_ME_strong_random
# OPTION B (self-hosted, default in the compose file):
RABBITMQ_URL=amqp://mas_sular:CHANGE_ME_strong_random@rabbitmq:5672
# OPTION A (external managed broker) — use instead of the line above:
# RABBITMQ_URL=amqps://user:pass@your-instance.cloudamqp.com/vhost

# --- Auth secrets (each >= 32 chars, unique) --------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_32_plus_chars_unique_value
JWT_REFRESH_SECRET=CHANGE_ME_32_plus_chars_different_value
JWT_ADMIN_ACCESS_SECRET=CHANGE_ME_32_plus_chars_another_value
COOKIE_SECRET=CHANGE_ME_32_plus_chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# --- URLs / CORS ------------------------------------------------------------
NODE_ENV=production
APP_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com
PAYMENT_UPLOAD_BASE_URL=https://app.example.com

# --- Build-time public values (inlined into the browser bundles) ------------
# Changing these requires an image REBUILD, not just a restart.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_ADMIN_API_URL=https://api.example.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id
NEXT_PUBLIC_SUPPORT_URL=mailto:cs@example.com

# --- Checkout idempotency ---------------------------------------------------
# Startup validation REQUIRES "true" outside development/test — leaving it unset
# makes the API refuse to boot with NODE_ENV=production.
CHECKOUT_IDEMPOTENCY_ENABLED=true
CHECKOUT_IDEMPOTENCY_REQUIRED=true

# --- Midtrans ---------------------------------------------------------------
# Going live means MIDTRANS_ENABLED=true, MIDTRANS_IS_PRODUCTION=true AND real
# production keys. Boot refuses a sandbox/production mismatch in either
# direction. Left disabled here so the template boots without credentials.
MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# MIDTRANS_BASE_URL — do NOT define this key unless you need a custom endpoint.
# It is validated as a URL, so an EMPTY value fails startup; the key must be
# absent to fall back to the default derived from MIDTRANS_IS_PRODUCTION.

# --- Async pipeline ---------------------------------------------------------
OUTBOX_RELAY_ENABLED=true
CONSUMERS_ENABLED=true
PAYMENT_LIFECYCLE_ENABLED=true
MIDTRANS_RECONCILIATION_ENABLED=true

# --- Notifications (optional) ----------------------------------------------
NOTIFICATION_SENDER_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=orders@example.com
