# Mas Sular — PRODUCTION environment contract (template).
#
#   cp production.env.example production.env && chmod 600 production.env
#   docker compose --env-file ./production.env -f docker-compose.production.yml up -d --build
#
# production.env holds live secrets and is gitignored. NEVER commit it.
#
# Placeholders are deliberately UNBOOTABLE: with NODE_ENV=production the API refuses
# to start while any value still contains CHANGE_ME or a <PLACEHOLDER>, so a
# half-filled file fails loudly instead of running on a known secret.
#
#   <ROOT_DOMAIN>   the registrable domain shared by all three hosts
#   <SHOP_DOMAIN>   storefront host   (e.g. shop.<ROOT_DOMAIN>)
#   <ADMIN_DOMAIN>  admin host        (e.g. admin.<ROOT_DOMAIN>)
#   <API_DOMAIN>    API host          (e.g. api.<ROOT_DOMAIN>)
#
# Every key validated by backend/src/common/config/env.validation.ts is either set
# below, or listed COMMENTED OUT with the condition that makes it required. Keys the
# validator checks for shape (URLs, enums, phone formats) must be ABSENT, not empty,
# when unused - an empty value fails startup.

# =============================================================================
# 1. DATA SERVICES (internal Docker network only - never published)
# =============================================================================
POSTGRES_DB=mas_sular
POSTGRES_USER=mas_sular
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
# Host is the compose SERVICE NAME. Size the pool explicitly: it is shared by HTTP
# traffic and every background worker, and exhausts silently as P2024 timeouts.
DATABASE_URL=postgresql://mas_sular:CHANGE_ME_strong_random_password@postgres:5432/mas_sular?connection_limit=15&pool_timeout=20&schema=public

REDIS_URL=redis://redis:6379

RABBITMQ_USER=mas_sular
RABBITMQ_PASSWORD=CHANGE_ME_strong_random_password
# Self-hosted broker (the compose default). A managed amqps:// URL may replace it.
RABBITMQ_URL=amqp://mas_sular:CHANGE_ME_strong_random_password@rabbitmq:5672

# =============================================================================
# 2. SECRETS (each >= 32 chars, all different: `openssl rand -hex 32`)
# =============================================================================
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ADMIN_ACCESS_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
# Token lifetimes - optional; unset uses the code defaults (customer access 15m,
# refresh 30d, admin access 8h). Set only for a deliberate policy change.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# Admin access token = admin session length. HOURS only (<n>s|<n>m|<n>h), max 12h;
# a days value (e.g. 1d, 6d) is REFUSED at boot. There is no admin refresh token:
# the admin signs in again when it expires. Logout revokes the session server-side.
# JWT_ADMIN_ACCESS_TTL=8h

# =============================================================================
# 3. PUBLIC URLS, REVERSE PROXY, COOKIES, CORS, CSRF
# =============================================================================
NODE_ENV=production
# Where the API is reached; also the origin of uploaded-file URLs (/uploads/...).
APP_URL=https://<API_DOMAIN>
# The STOREFRONT origin. Customer links are built on it:
#   invoice        https://<SHOP_DOMAIN>/invoice/<token>
#   receipt upload https://<SHOP_DOMAIN>/payment/<token>
PAYMENT_UPLOAD_BASE_URL=https://<SHOP_DOMAIN>
# Admin origin, used in links inside operational notifications.
ADMIN_URL=https://<ADMIN_DOMAIN>
# Browser origins allowed to call the API with credentials. Explicit list, no "*".
CORS_ORIGINS=https://<SHOP_DOMAIN>,https://<ADMIN_DOMAIN>

# ONE reverse proxy (Caddy/Nginx) sits in front of the API and the API publishes
# no host port, so exactly one hop is trusted: req.ip - and every rate-limit
# bucket - becomes the real client, and client-forged X-Forwarded-For entries are
# ignored. REQUIRED in production. Raise only if another APPENDING proxy/CDN is
# added in front.
TRUST_PROXY_HOPS=1

# Customer login is httpOnly-cookie based: the storefront sends NO Authorization
# header. REQUIRED "true" - otherwise every customer request is anonymous.
AUTH_COOKIE_EXTRACTOR_ENABLED=true
# Topology: three hosts under one registrable domain. The API sets its cookies for
# the PARENT domain so the storefront (a sibling host) can read the non-httpOnly
# XSRF-TOKEN cookie and echo it in X-CSRF-Token; shop/admin/api are the SAME SITE,
# so SameSite=Lax cookies accompany the storefront's credentialed API calls.
# Leading dot, no scheme, no port.
COOKIE_DOMAIN=.<ROOT_DOMAIN>
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# The httpOnly ADMIN session cookie is HOST-ONLY on the API host by default (it is
# never sent to sibling subdomains and cannot collide with another environment
# under the same parent domain). Leave unset unless a deliberate reason exists.
# ADMIN_COOKIE_DOMAIN=
# Double-submit CSRF protection for cookie-authenticated writes. Keep "enforce".
# ("report" logs "[CSRF report] would block" without blocking - a temporary
# rollout diagnostic only, never a steady state.)
CSRF_MODE=enforce

# Swagger stays OFF in production unless this is set - leave it absent.
# /metrics is internal-only: served to direct in-network scrapes (no proxy
# headers). Set this (>= 32 chars) only if a scraper must come through the proxy
# and present it as a Bearer token. nginx also denies /metrics publicly.
# METRICS_TOKEN=CHANGE_ME
# SWAGGER_ENABLED=true

# =============================================================================
# 4. BUILD-TIME PUBLIC VALUES (compiled into the browser bundles)
#    Changing any of these requires `up -d --build <service>` - never `restart`.
#    They are public by definition: never put a secret here.
# =============================================================================
# Storefront: the BARE API origin - the storefront appends /api/v1 itself.
# (Its image build refuses a value ending in /api/v1.)
NEXT_PUBLIC_API_URL=https://<API_DOMAIN>
# Admin: the API base INCLUDING /api/v1 - the admin appends paths directly.
# (Its image build refuses anything that is not http(s)://.../api/v1.)
NEXT_PUBLIC_ADMIN_API_URL=https://<API_DOMAIN>/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
NEXT_PUBLIC_SUPPORT_URL=mailto:<SUPPORT_EMAIL>
# Storefront floating WhatsApp support button (public, compiled into the bundle; a
# change needs a storefront rebuild). 08... / +62 / spaces / dashes are normalized
# to 62...; an empty or invalid number hides the button. The message is optional.
NEXT_PUBLIC_WHATSAPP_NUMBER=628811010452031
NEXT_PUBLIC_WHATSAPP_MESSAGE=Halo Kak, saya ingin bertanya mengenai Bakso Mas Sular.

# Google Sign-In: the same OAuth client id, verified server-side. Its authorized
# JavaScript origin must include https://<SHOP_DOMAIN>.
GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>

# =============================================================================
# 5. CHECKOUT
# =============================================================================
# REQUIRED "true" in production (boot refuses otherwise): a retried checkout can
# never create a second order/payment/reservation.
CHECKOUT_IDEMPOTENCY_ENABLED=true
CHECKOUT_IDEMPOTENCY_REQUIRED=true
# Manual bank-transfer unique code (adds 100-999 to the amount to match transfers).
# A business decision - "true" to turn on; the range is optional.
PAYMENT_UNIQUE_CODE_ENABLED=false
# PAYMENT_UNIQUE_CODE_MIN=100
# PAYMENT_UNIQUE_CODE_MAX=999

# =============================================================================
# 6. BACKGROUND WORKERS (one backend replica runs all of them)
# =============================================================================
OUTBOX_RELAY_ENABLED=true
CONSUMERS_ENABLED=true
PAYMENT_LIFECYCLE_ENABLED=true
# Gateway (Midtrans) attempts expire after 24 h (0 = never). Set explicitly: the
# payment lifecycle and the stock-reservation hold do not share one code default.
PAYMENT_GATEWAY_EXPIRY_MS=86400000
# Backstop that expires stale stock reservations.
INVENTORY_RESERVATION_WORKER_ENABLED=true
# Courier tracking polls (IN_TRANSIT -> DELIVERED) and the booking of paid orders
# whose automatic courier booking never ran. Harmless while no courier is enabled.
SHIPMENT_TRACKING_ENABLED=true
SHIPMENT_RECONCILIATION_ENABLED=true
# Deletes old outbox/processed-event/upload-token rows. Start with DRY RUN, read the
# "worker.retention" logs, then set RETENTION_DRY_RUN=false.
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true
# SystemLog persistence + its retention sweep (defaults on; 90 days).
SYSTEM_LOG_ENABLED=true
SYSTEM_LOG_RETENTION_ENABLED=true
LOG_RETENTION_DAYS=90
# Only meaningful with Midtrans (section 10).
MIDTRANS_RECONCILIATION_ENABLED=false

# =============================================================================
# 7. COURIERS - at least one must be enabled or checkout has no shipping quote.
#
# Boot REFUSES a courier without an ACTIVE outlet (its shipping origin). First
# deploy: keep couriers false, create the real outlet in the admin panel, then
# enable and `up -d --force-recreate backend`. Credentials come from the courier;
# never from this file.
# =============================================================================
PAXEL_ENABLED=false
# REQUIRED when PAXEL_ENABLED=true (uncomment all):
# PAXEL_BASE_URL=<PAXEL_PRODUCTION_BASE_URL_FROM_PAXEL>     # set explicitly; the code default is unverified
# PAXEL_API_KEY=<FROM_PAXEL>
# PAXEL_API_SECRET=<FROM_PAXEL>                              # signs X-Paxel-Signature
# PAXEL_ORIGIN_PHONE=<9_TO_13_DIGITS>                        # merchant pickup contact
# PAXEL_ORIGIN_NOTE=<REAL_PICKUP_INSTRUCTION>
# PAXEL_DEFAULT_DIMENSION=<LxWxH_CM e.g. 30x35x20>           # Paxel prices from it
# Automatic Paxel booking on payment (P2 #15). Anything but "true" is OFF.
PAXEL_AUTO_PICKUP_ENABLED=false
# Optional pickup-rule overrides (defaults: cut-off 15:00, pickup 17:00, Asia/Jakarta):
# PAXEL_PICKUP_TIMEZONE=Asia/Jakarta
# PAXEL_PICKUP_CUTOFF_TIME=15:00
# PAXEL_PICKUP_DEFAULT_TIME=17:00
# PAXEL_NEED_INSURANCE=false

# Paxel webhook (Paxel pushes shipment status; independent of PAXEL_ENABLED).
# Paxel must POST (Content-Type: application/json, X-Paxel-Signature header) to:
#   <APP_URL>/api/v1/shipments/webhook/paxel   (APP_URL above, i.e. https://<API_DOMAIN>/...)
# Never register a localhost or internal address. The signature is verified with
# PAXEL_WEBHOOK_SECRET (REQUIRED when enabled). The exact signature formula/secret,
# the acknowledgement Paxel expects and its source IPs still NEED PAXEL
# CONFIRMATION: keep this false until the runbook
# (backend/src/modules/shipment/paxel-webhook.RUNBOOK.md) is complete. Changing it
# needs `up -d --force-recreate backend` (read at boot).
PAXEL_WEBHOOK_ENABLED=false
# PAXEL_WEBHOOK_SECRET=<FROM_PAXEL>

JNE_ENABLED=false
# REQUIRED when JNE_ENABLED=true (uncomment all). Production rejects the sandbox URL.
# JNE_ENVIRONMENT=production
# JNE_BASE_URL=<JNE_PRODUCTION_BASE_URL_FROM_JNE>
# JNE_API_KEY=<FROM_JNE>
# JNE_USERNAME=<FROM_JNE>
# JNE_ORIGIN_CODE=<FROM_JNE>
# JNE also needs its destination master data imported once (runbook, H5).

# JNE /pickupcashless merchant & pickup master data. REQUIRED when JNE_ENABLED=true
# (boot fails and names every missing key). No defaults: BRANCH, CUST_ID and
# MERCHANT_ID are issued by JNE; the rest are real facts about the shop's pickup
# point. Empty placeholders below mean UNSET and are safe while JNE_ENABLED=false.
# Enumerations (case-sensitive, as documented by JNE):
#   JNE_PICKUP_SERVICE = Domestic | Intracity | All
#   JNE_PICKUP_VEHICLE = Motor | Mobil | Truck
#   JNE_TYPE           = DROP | PICKUP
JNE_PICKUP_NAME=
JNE_PICKUP_PIC=
JNE_PICKUP_PIC_PHONE=
JNE_PICKUP_ADDRESS=
JNE_PICKUP_DISTRICT=
JNE_PICKUP_CITY=
JNE_PICKUP_SERVICE=
JNE_PICKUP_VEHICLE=

JNE_BRANCH=
JNE_CUST_ID=
JNE_MERCHANT_ID=

JNE_SHIPPER_NAME=
JNE_SHIPPER_ADDR1=
JNE_SHIPPER_ADDR2=
JNE_SHIPPER_CITY=
JNE_SHIPPER_ZIP=
JNE_SHIPPER_REGION=
JNE_SHIPPER_CONTACT=
JNE_SHIPPER_PHONE=

JNE_TYPE=

# JNE Webhook Status V2 (JNE pushes shipment status; independent of JNE_ENABLED).
# JNE must POST (Content-Type: application/json) to the PUBLIC production URL:
#   <APP_URL>/api/v1/shipments/webhook/jne   (APP_URL above, i.e. https://<API_DOMAIN>/...)
# Never register a localhost or internal address. JNE's V2 documentation defines NO
# webhook authentication - the body's `signature` field is the recipient's signature
# IMAGE URL, not a request signature. Keep this false until the go-live runbook
# (backend/src/modules/shipment/jne-webhook.RUNBOOK.md) is complete, including the
# reverse-proxy restriction of that path to JNE's source IPs. Changing it needs
# `up -d --force-recreate backend` (read at boot).
JNE_WEBHOOK_ENABLED=false

# Obsolete - do not set. The shipping origin is the ACTIVE outlet's postal code
# (admin panel). The validator still accepts this key so an old file keeps
# booting, but no code reads it.
# SHIPPING_ORIGIN_POSTAL_CODE=
# RajaOngkir is not used in production.
RAJAONGKIR_ENABLED=false

# =============================================================================
# 8. ADDRESS GEOCODING (server-side only)
# Paxel prices and books on coordinates; enable with a real, API-restricted key.
# =============================================================================
GEOCODING_ENABLED=false
# REQUIRED when GEOCODING_ENABLED=true:
# GOOGLE_MAPS_API_KEY=<SERVER_SIDE_GEOCODING_KEY>

# =============================================================================
# 9. CUSTOMER NOTIFICATIONS (WhatsApp via Mekari Qontak, email via Resend)
#
# Development/test safety defaults: sender off, delivery off, allowlist policy.
# Production go-live values, once credentials and templates exist:
#   NOTIFICATION_SENDER_ENABLED=true
#   NOTIFICATION_DELIVERY_ENABLED=true
#   NOTIFICATION_RECIPIENT_POLICY=all      (production-only; boot rejects it elsewhere)
# "all" widens WHO may receive a message; the switches, recipient validation and
# template/credential checks still apply. Before first enabling the sender, review
# NotificationOutbox PENDING rows - they are all sent the moment it starts.
# =============================================================================
NOTIFICATION_SENDER_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_RECIPIENT_POLICY=allowlist
# Allowlist (policy=allowlist only): comma-separated phones/emails, e.g. an ops
# phone for a pilot. Empty blocks every customer message.
NOTIFICATION_ALLOWED_RECIPIENTS=
NOTIFICATION_PROVIDER=multi

# Resend - REQUIRED when NOTIFICATION_SENDER_ENABLED=true (even for WhatsApp-only).
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_FROM must be on a domain verified in Resend, e.g. orders@<ROOT_DOMAIN>.
# ADMIN_NOTIFICATION_EMAIL=<OPS_INBOX>

# Qontak - REQUIRED when the sender is enabled (boot refuses otherwise):
QONTAK_API_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
QONTAK_INVOICE_TEMPLATE_ID=
QONTAK_ORDER_TEMPLATE_ID=
QONTAK_COD_TEMPLATE_ID=
QONTAK_SHIPPED_TEMPLATE_ID=
QONTAK_DELIVERED_TEMPLATE_ID=
# Operational WhatsApp recipient for new-order alerts.
QONTAK_ADMIN=
# P2 #14 "Send via WhatsApp" invoice link (the admin button returns 400 without it):
QONTAK_MANUAL_TEMPLATE_ID=
# Optional shipment-status template:
QONTAK_SHIPMENT_TEMPLATE_ID=
# The transfer template's URL button must point at https://<SHOP_DOMAIN>/payment/{{1}}
# (the token is sent as the button parameter).
# QONTAK_BASE_URL - leave ABSENT: it defaults to the real endpoint, and an empty
# value fails startup.

# =============================================================================
# 10. PAYMENT GATEWAY (Midtrans) - optional; manual bank transfer works without it
# Going live: MIDTRANS_ENABLED=true, MIDTRANS_IS_PRODUCTION=true, production keys,
# MIDTRANS_RECONCILIATION_ENABLED=true, and in the Midtrans dashboard the
# notification URL https://<API_DOMAIN>/api/v1/payments/webhook/midtrans.
# Boot refuses a sandbox/production mismatch either way.
# =============================================================================
MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# MIDTRANS_BASE_URL - leave ABSENT (derived from MIDTRANS_IS_PRODUCTION); empty fails.

# Who bears the Midtrans fee ("Biaya Layanan"). INDEPENDENT of MIDTRANS_ENABLED.
#   false (default, always supported) - customer pays Rp0; the merchant absorbs the
#         fee, which is still calculated and recorded per order and payment attempt.
#   true  - the applicable fee is added to the customer total for VA and e-wallet
#         channels only. QRIS (BI MDR) and cards are NEVER passed on, whatever this
#         says. Get legal sign-off first: PBI 23/6/PBI/2021 Pasal 52 restricts
#         surcharging payment-provider fees to customers.
PAYMENT_SERVICE_FEE_ENABLED=false

# Payment channels a customer may choose for a NEW payment: "true" / "false" only.
# ABSENT = enabled. Gateway channels additionally need MIDTRANS_ENABLED=true; manual
# transfer needs an active PaymentAccount. Boot fails when nothing is left to pay with.
# Switching a channel off never breaks a payment already open on it (status, webhook,
# expiry, reconciliation and the payment page keep working). Read at boot: changing a
# value needs `up -d --force-recreate backend`.
PAYMENT_TRANSFER_ENABLED=true
PAYMENT_QRIS_ENABLED=true
PAYMENT_EWALLET_GOPAY_ENABLED=true
PAYMENT_EWALLET_SHOPEEPAY_ENABLED=true
PAYMENT_VA_BCA_ENABLED=true
PAYMENT_VA_BNI_ENABLED=true
PAYMENT_VA_BRI_ENABLED=true
PAYMENT_VA_MANDIRI_ENABLED=true
PAYMENT_VA_PERMATA_ENABLED=true
# SeaBank VA is NOT implemented (no Midtrans channel code or fee rule): true fails boot.
PAYMENT_VA_SEABANK_ENABLED=false
PAYMENT_CREDIT_CARD_ENABLED=true

# Per-channel fee pass-through ("Biaya Layanan"): "true" / "false" only.
# ABSENT = inherit PAYMENT_SERVICE_FEE_ENABLED. The fee is ALWAYS calculated and
# recorded; this only decides who pays it. Boot fails for a pass-through that can never
# happen: QRIS and CREDIT_CARD (Bank Indonesia prohibition), TRANSFER (no fee rule),
# SEABANK (not implemented).
# PAYMENT_FEE_TRANSFER_ENABLED=false
# PAYMENT_FEE_QRIS_ENABLED=false
# PAYMENT_FEE_EWALLET_GOPAY_ENABLED=false
# PAYMENT_FEE_EWALLET_SHOPEEPAY_ENABLED=false
# PAYMENT_FEE_VA_BCA_ENABLED=false
# PAYMENT_FEE_VA_BNI_ENABLED=false
# PAYMENT_FEE_VA_BRI_ENABLED=false
# PAYMENT_FEE_VA_MANDIRI_ENABLED=false
# PAYMENT_FEE_VA_PERMATA_ENABLED=false
# PAYMENT_FEE_VA_SEABANK_ENABLED=false
# PAYMENT_FEE_CREDIT_CARD_ENABLED=false

# =============================================================================
# 11. OPTIONAL
# =============================================================================
# Admin web push (Firebase service account JSON, one line). Absent = push disabled.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# =============================================================================
# 12. TUNING - leave absent to use the code defaults shown. Validated when set.
# =============================================================================
# Payment windows (must satisfy FIRST < SECOND < EXPIRY):
# PAYMENT_FIRST_REMINDER_MS=43200000        # 12 h
# PAYMENT_SECOND_REMINDER_MS=72000000       # 20 h
# PAYMENT_EXPIRY_MS=86400000                # 24 h
# (PAYMENT_GATEWAY_EXPIRY_MS is set explicitly in section 6.)
# Outbound HTTP timeouts / in-call retries (the durable outbox retries separately):
# MIDTRANS_TIMEOUT_MS=10000
# MIDTRANS_MAX_RETRY=2
# QONTAK_TIMEOUT_MS=10000
# QONTAK_MAX_RETRY=1
# PAXEL_TIMEOUT_MS=8000
# PAXEL_MAX_RETRY=2                         # quotes only; Paxel CREATE is never retried
# JNE_TIMEOUT_MS=8000
# JNE_MAX_RETRY=2
# GEOCODING_TIMEOUT_MS=5000
# Custom endpoints - leave ABSENT (an empty value fails startup):
# MIDTRANS_BASE_URL=
# QONTAK_BASE_URL=
# GOOGLE_GEOCODING_BASE_URL=
